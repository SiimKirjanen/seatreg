		{
			"name": "Bookings",
			"item": [
				{
					"name": "Missing calendar date",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 400 calendar_date_not_provided\", () => {",
									"    pm.response.to.have.status(400);",
									"    pm.expect(pm.response.json().code).to.eql(\"calendar_date_not_provided\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings?api_token={{token}}&seatreg_api={{apiVersion}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings"
							],
							"query": [
								{
									"key": "api_token",
									"value": "{{token}}"
								},
								{
									"key": "seatreg_api",
									"value": "{{apiVersion}}"
								}
							]
						}
					}
				},
				{
					"name": "Confirmed and approved bookings",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 200 ok\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().message).to.eql(\"ok\");",
									"});",
									"",
									"pm.test(\"returns only Approved and Pending\", () => {",
									"    const names = pm.response.json().bookings.map((booking) => booking.first_name).sort();",
									"    pm.expect(names).to.eql([\"Approved\",\"Pending\"]);",
									"});",
									"",
									"pm.test(\"names the room each booking is in\", () => {",
									"    pm.response.json().bookings.forEach((booking) => pm.expect(booking.room_name).to.eql(\"API hall\"));",
									"});",
									"",
									"pm.test(\"says calendar mode is off\", () => {",
									"    pm.expect(pm.response.json().options.usingCalendar).to.eql(\"0\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings?api_token={{token}}&seatreg_api={{apiVersion}}&calendar_date=2030-01-10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings"
							],
							"query": [
								{
									"key": "api_token",
									"value": "{{token}}"
								},
								{
									"key": "seatreg_api",
									"value": "{{apiVersion}}"
								},
								{
									"key": "calendar_date",
									"value": "2030-01-10"
								}
							]
						}
					}
				},
				{
					"name": "Calendar registration filters by date",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 200 ok\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().message).to.eql(\"ok\");",
									"});",
									"",
									"pm.test(\"returns only First day\", () => {",
									"    const names = pm.response.json().bookings.map((booking) => booking.first_name).sort();",
									"    pm.expect(names).to.eql([\"First day\"]);",
									"});",
									"",
									"pm.test(\"hands back the calendar dates\", () => {",
									"    const options = pm.response.json().options;",
									"    pm.expect(options.usingCalendar).to.eql(\"1\");",
									"    pm.expect(options.calendarDates).to.eql(\"2030-01-10,2030-01-11\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings?api_token={{calendarToken}}&seatreg_api={{apiVersion}}&calendar_date=2030-01-10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings"
							],
							"query": [
								{
									"key": "api_token",
									"value": "{{calendarToken}}"
								},
								{
									"key": "seatreg_api",
									"value": "{{apiVersion}}"
								},
								{
									"key": "calendar_date",
									"value": "2030-01-10"
								}
							]
						}
					}
				}
			]
		},
