								"exec": [
									"pm.test(\"answers 401 no_token\", () => {",
									"    pm.response.to.have.status(401);",
									"    pm.expect(pm.response.json().code).to.eql(\"no_token\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/validate-token?seatreg_api={{apiVersion}}",
