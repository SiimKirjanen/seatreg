{
	"info": {
		"name": "SeatReg public API",
		"description": "Runs against the wp-env site after `npm run test:api:seed`. See README.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Echo",
			"item": [
				{
					"name": "Answers without a token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 200 ok\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().message).to.eql(\"ok\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/echo",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"echo"
							],
							"query": []
						}
					}
				}
			]
		},
		{
			"name": "Validate token",
			"item": [
				{
					"name": "Valid token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 200 ok\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().message).to.eql(\"ok\");",
									"});",
									"",
									"pm.test(\"names the token's registration\", () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.apiToken).to.eql(pm.variables.get(\"token\"));",
									"    pm.expect(body.registrationName).to.eql(\"API test registration\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/validate-token?api_token={{token}}&seatreg_api={{apiVersion}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"validate-token"
							],
							"query": [
								{
									"key": "api_token",
									"value": "{{token}}"
								},
								{
									"key": "seatreg_api",
									"value": "{{apiVersion}}"
								}
							]
						}
					}
				},
				{
