				{
					"name": "Public API turned off",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"answers 403 public_api_not_enabled\", () => {",
									"    pm.response.to.have.status(403);",
